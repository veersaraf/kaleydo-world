{
  "name": "kaleydo-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Motion-controlled sports in your browser. Your phone is the remote.",
  "scripts": {
    "dev": "node server/server.mjs --dev",
    "build": "vite build",
    "start": "vite build && node server/server.mjs",
    "serve": "node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:cloud": "tsc -p cloud/tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run typecheck:cloud && node scripts/check/run.mjs",
    "test:sims": "node scripts/check/run.mjs --sims",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:cloud": "node scripts/e2e/run.mjs --cloud",
    "cloud:dev": "vite build && wrangler dev --port 8787",
    "cloud:deploy": "vite build && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/kaushan-script": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^26.6.3",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.143.0"
  }
}
