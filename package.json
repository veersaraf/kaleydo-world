{
  "name": "kaleido",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KALEIDO — a motion-controlled sports game across worlds. Your phone is the remote, your Mac is the TV.",
  "scripts": {
    "dev": "node server/server.mjs --dev",
    "build": "vite build",
    "start": "vite build && node server/server.mjs",
    "serve": "node server/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/kaushan-script": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
